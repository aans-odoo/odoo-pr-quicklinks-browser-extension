{
  "manifest_version": 3,
  "name": "Odoo PR Quicklinks",
  "version": "1.2.0",
  "description": "Adds buttons on GitHub PRs to copy the branch name and open Runbot search.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
